<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wxpusher.chrome-debug</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Google Chrome.app/Contents/MacOS/Google Chrome</string>
    <string>--remote-debugging-address=127.0.0.1</string>
    <string>--remote-debugging-port=9222</string>
    <string>--user-data-dir=/Users/hhh/wxpusher-bridge-chrome-profile</string>
    <string>--no-first-run</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/wxpusher-chrome-debug.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/wxpusher-chrome-debug.err.log</string>
</dict>
</plist>
